#include <ECE3.h>

// =====================================================
// 1. IR SENSOR CONFIGURATION
// =====================================================

uint16_t sensorValues[8];

const uint8_t sensor_count = 8;

const int weights[8] = {
    25, 24, 8, 2, -2, -8, -24, -25};

int minValues[8] = {
    794, 567, 612, 521, 589, 589, 657, 612};

int maxValues[8] = {
    2500, 2282, 2213, 1677, 1910, 1840, 2330, 2500};
// =====================================================
// 2. MOTOR PINS
// =====================================================

const int left_nslp_pin = 31;
const int right_nslp_pin = 11;

const int left_dir_pin = 29;
const int right_dir_pin = 30;

const int left_pwm_pin = 40;
const int right_pwm_pin = 39;

const int LED_RF = 41;

// =====================================================
// 3. PD CONTROLLER
// =====================================================

float KP = 0.25;
float KD = 1.0;

float error = 0;
float prevError = 0;
float derivative = 0;
float correction = 0;

int base_speed = 110;

// =====================================================
// 4. MOTOR SPEED VARIABLES
// =====================================================

int currentLeftSpeed = 0;
int currentRightSpeed = 0;

// =====================================================
// 5. DATA LOGGER CONFIGURATION
// =====================================================

const unsigned long START_DELAY_TIME = 2000; // 2 seconds
const unsigned long RUN_TIME = 3000;         // 3 seconds
const unsigned long SAMPLE_INTERVAL = 10;    // 10 ms

const int MAX_SAMPLES = 300;

struct DataPoint
{

    unsigned long time_ms;

    uint16_t sensor[8];

    float error;
    float derivative;
    float correction;

    int left_speed;
    int right_speed;
};

DataPoint dataLog[MAX_SAMPLES];

int sampleCount = 0;

// =====================================================
// 6. STATE MACHINE
// =====================================================

enum LoggerState
{

    READY,
    START_DELAY,
    RECORDING,
    DATA_READY,
    PRINTING
};

LoggerState state = READY;

// =====================================================
// 7. S1 BUTTON CONFIGURATION
// MSP432P401R LaunchPad
//
// S1 = P1.1
// Active LOW
//
// Direct GPIO register access avoids uncertainty
// about Energia digital pin numbering.
// =====================================================

const unsigned long DEBOUNCE_TIME = 30;

int lastButtonReading = HIGH;
int stableButtonState = HIGH;

unsigned long lastDebounceTime = 0;

// =====================================================
// 8. TIMING VARIABLES
// =====================================================

unsigned long delayStartTime = 0;
unsigned long runStartTime = 0;
unsigned long lastSampleTime = 0;

// =====================================================
// 9. MOTOR CONTROL FUNCTIONS
// =====================================================

void setMotor(int motor_speed, int dir_pin, int pwm_pin)
{

    motor_speed = constrain(motor_speed, -255, 255);

    if (motor_speed == 0)
    {
        analogWrite(pwm_pin, 0);
        return;
    }

    if (motor_speed > 0)
    {
        digitalWrite(dir_pin, LOW);
    }
    else
    {
        digitalWrite(dir_pin, HIGH);
    }

    analogWrite(pwm_pin, abs(motor_speed));
}

void stopMotors()
{

    setMotor(0, left_dir_pin, left_pwm_pin);
    setMotor(0, right_dir_pin, right_pwm_pin);
}

// =====================================================
// 10. BUTTON READ FUNCTION
// S1 is P1.1
// =====================================================

int readS1()
{

    // LOW = pressed
    // HIGH = released
    if (P1->IN & BIT1)
    {
        return HIGH;
    }
    else
    {
        return LOW;
    }
}

// =====================================================
// 11. BUTTON DEBOUNCE
// Returns TRUE once per button press
// =====================================================

bool buttonPressed()
{

    int reading = readS1();

    if (reading != lastButtonReading)
    {
        lastDebounceTime = millis();
    }

    if (millis() - lastDebounceTime >= DEBOUNCE_TIME)
    {

        if (reading != stableButtonState)
        {

            stableButtonState = reading;

            if (stableButtonState == LOW)
            {
                lastButtonReading = reading;
                return true;
            }
        }
    }

    lastButtonReading = reading;

    return false;
}

// =====================================================
// 12. CALCULATE ERROR
// Original sensor normalization and weighted error
// =====================================================

float calculateError()
{

    float newError = 0;

    for (int i = 0; i < sensor_count; i++)
    {

        long raw = sensorValues[i];

        long normalized =
            (raw - minValues[i]) * 1000L / (maxValues[i] - minValues[i]);

        normalized = constrain(normalized, 0, 1000);

        int holdError = (normalized * weights[i]) / 8;

        newError += holdError;
    }

    return newError;
}

// =====================================================
// 13. PD CALCULATION
// =====================================================

void calculatePD()
{

    error = calculateError();

    derivative = error - prevError;

    correction = KP * error + KD * derivative;
}

// =====================================================
// 14. MOTOR CONTROL USING PD OUTPUT
// =====================================================

void controlMotors()
{

    int right_speed = base_speed - (int)correction;
    int left_speed = base_speed + (int)correction;

    right_speed = constrain(right_speed, -255, 255);
    left_speed = constrain(left_speed, -255, 255);

    setMotor(right_speed, right_dir_pin, right_pwm_pin);
    setMotor(left_speed, left_dir_pin, left_pwm_pin);

    currentLeftSpeed = left_speed;
    currentRightSpeed = right_speed;

    prevError = error;
}

// =====================================================
// 15. RECORD DATA
// =====================================================

void recordData()
{

    if (sampleCount >= MAX_SAMPLES)
    {
        return;
    }

    DataPoint &d = dataLog[sampleCount];

    d.time_ms = millis() - runStartTime;

    for (int i = 0; i < 8; i++)
    {
        d.sensor[i] = sensorValues[i];
    }

    d.error = error;
    d.derivative = derivative;
    d.correction = correction;

    d.left_speed = currentLeftSpeed;
    d.right_speed = currentRightSpeed;

    sampleCount++;
}

// =====================================================
// 16. START 2-SECOND DELAY
// =====================================================

void startDelay()
{

    sampleCount = 0;

    error = 0;
    prevError = 0;
    derivative = 0;
    correction = 0;

    currentLeftSpeed = 0;
    currentRightSpeed = 0;

    stopMotors();

    delayStartTime = millis();

    state = START_DELAY;

    digitalWrite(LED_RF, HIGH);
}

// =====================================================
// 17. START RECORDING AFTER 2-SECOND DELAY
// =====================================================

void beginRecording()
{

    runStartTime = millis();
    lastSampleTime = runStartTime;

    state = RECORDING;
}

// =====================================================
// 18. PRINT DATA AS CSV
// =====================================================

void printData()
{

    Serial.println(
        "time_ms,"
        "S0,S1,S2,S3,S4,S5,S6,S7,"
        "error,derivative,correction,"
        "left_speed,right_speed");

    for (int i = 0; i < sampleCount; i++)
    {

        DataPoint &d = dataLog[i];

        Serial.print(d.time_ms);

        for (int j = 0; j < 8; j++)
        {
            Serial.print(",");
            Serial.print(d.sensor[j]);
        }

        Serial.print(",");
        Serial.print(d.error, 2);

        Serial.print(",");
        Serial.print(d.derivative, 2);

        Serial.print(",");
        Serial.print(d.correction, 2);

        Serial.print(",");
        Serial.print(d.left_speed);

        Serial.print(",");
        Serial.println(d.right_speed);
    }

    Serial.println("END_OF_DATA");
}

// =====================================================
// 19. SETUP
// =====================================================

void setup()
{

    // Motor pins
    pinMode(left_nslp_pin, OUTPUT);
    pinMode(right_nslp_pin, OUTPUT);

    pinMode(left_dir_pin, OUTPUT);
    pinMode(right_dir_pin, OUTPUT);

    pinMode(left_pwm_pin, OUTPUT);
    pinMode(right_pwm_pin, OUTPUT);

    // LED
    pinMode(LED_RF, OUTPUT);

    // Configure S1 = P1.1 as input with pull-up
    P1->DIR &= ~BIT1; // Input
    P1->REN |= BIT1;  // Enable resistor
    P1->OUT |= BIT1;  // Pull-up

    // Enable motor drivers
    digitalWrite(left_nslp_pin, HIGH);
    digitalWrite(right_nslp_pin, HIGH);

    stopMotors();

    // Initialize sensors
    ECE3_Init();

    // Serial
    Serial.begin(115200);

    digitalWrite(LED_RF, LOW);

    // Initialize button debounce
    lastButtonReading = readS1();
    stableButtonState = lastButtonReading;
}

// =====================================================
// 20. MAIN LOOP
// =====================================================

void loop()
{

    bool pressed = buttonPressed();

    // ---------------------------------------------------
    // STATE 1: READY
    // Press S1 -> Start 2-second delay
    // ---------------------------------------------------

    if (state == READY)
    {

        stopMotors();

        if (pressed)
        {
            startDelay();
        }
    }

    // ---------------------------------------------------
    // STATE 2: START_DELAY
    // Wait 2 seconds before car starts
    // ---------------------------------------------------

    else if (state == START_DELAY)
    {

        stopMotors();

        if (millis() - delayStartTime >= START_DELAY_TIME)
        {

            beginRecording();
        }
    }

    // ---------------------------------------------------
    // STATE 3: RECORDING
    // Car runs for 3 seconds
    // ---------------------------------------------------

    else if (state == RECORDING)
    {

        ECE3_read_IR(sensorValues);

        calculatePD();

        controlMotors();

        // Sample every 10 ms
        if (millis() - lastSampleTime >= SAMPLE_INTERVAL)
        {

            recordData();

            lastSampleTime = millis();
        }

        // Stop after 3 seconds
        if (millis() - runStartTime >= RUN_TIME)
        {

            stopMotors();

            currentLeftSpeed = 0;
            currentRightSpeed = 0;

            digitalWrite(LED_RF, LOW);

            state = DATA_READY;
        }
    }

    // ---------------------------------------------------
    // STATE 4: DATA_READY
    // Press S1 -> Export data
    // ---------------------------------------------------

    else if (state == DATA_READY)
    {

        stopMotors();

        if (pressed)
        {
            state = PRINTING;
        }
    }

    // ---------------------------------------------------
    // STATE 5: PRINTING
    // ---------------------------------------------------

    else if (state == PRINTING)
    {

        stopMotors();

        // Only export when USB Serial is connected
        if (Serial)
        {
            printData();
        }

        state = READY;
    }
}